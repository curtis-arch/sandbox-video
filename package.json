{
  "name": "sandbox-video",
  "version": "0.2.0",
  "private": false,
  "description": "High-FPS proof video capture for agent-browser sessions in Vercel Sandbox",
  "keywords": [
    "agent-browser",
    "ffmpeg",
    "screen-recording",
    "vercel-sandbox"
  ],
  "homepage": "https://github.com/curtis-arch/sandbox-video#readme",
  "bugs": {
    "url": "https://github.com/curtis-arch/sandbox-video/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtis-arch/sandbox-video.git"
  },
  "bin": {
    "sandbox-video": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "SKILL.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && tsc -p tsconfig.json --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "test": "pnpm build && node --test dist/test/uploads.test.js dist/test/cli.test.js dist/test/session.test.js",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0"
}
